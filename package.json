{
  "name": "ibef-scraper",
  "version": "1.0.0",
  "description": "Scrapes IBEF industry data into MongoDB for the backend startup report",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "scrape": "npm run build && node dist/scripts/scrape.js",
    "scrape:single": "npm run build && node dist/scripts/scrape-single.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.0",
    "mongoose": "^7.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
